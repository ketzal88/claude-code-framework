  "$unsyncedWhy": "rules/graphify.md documents how graphify is wired in the real project, but there is no source file to sync from: in the production repo that content lives inside CLAUDE.md, not as a standalone rule. Kept as an example-only note. Because it is not in 'map', sync-example.py never sanitizes it — keep it generic by hand.",
  "$archivedWhy": "The source project audited its setup on 2026-08-09 and archived 9 rules whose content was either already enforced by a blocking hook or folded into CLAUDE.md (see .claude/archive/rules/ there). Six are archived here too, under archive/rules/. Three are still mirrored from the source's archive — cron-security, alert-engine-pattern and regional-thresholds — because they carry domain facts no gate can recover (most of all: in ARS a ROAS of 50-500x is normal, not a bug).",
  "replacements": [
    { "pattern": "Worker[ _-]?Brain", "replace": "ExampleApp" },
    { "pattern": "WorkerBrain", "replace": "ExampleApp" },
    { "pattern": "worker-brain", "replace": "nextjs-firebase" },
    { "pattern": "ai-analyzer", "replace": "example-app" },
    { "pattern": "brain\\.worker\\.ar", "replace": "app.example.com" },
    { "pattern": "@worker\\.ar", "replace": "@example.com" },
    { "pattern": "ketzal88", "replace": "your-org" },
    { "pattern": "[Uu]sers[\\\\/]gabri", "replace": "Users/dev" },
    { "pattern": "\\bGabriel\\b", "replace": "el operador" },
    { "pattern": "\\bSebasti[aá]n\\b", "replace": "el operador" },
    { "pattern": "\\bBlunua\\b", "replace": "ClientA" },
    { "pattern": "\\bPaia\\b", "replace": "ClientB" },
    { "pattern": "\\belepants\\b", "replace": "ClientC" },
    { "pattern": "\\bPriscila\\b", "replace": "OwnerName" },
    { "pattern": "\\bCami\\b", "replace": "SpecialistName" },
    { "pattern": "C0[A-Z0-9]{8,}", "replace": "C0XXXXXXXXX" }
  ],
  "leakCheck": [
    "Worker[ _-]?Brain", "worker-brain", "brain\\.worker", "ketzal88",
    "ai-analyzer", "Users[\\\\/]gabri",
    "\\bGabriel\\b", "Blunua", "\\bPaia\\b", "@worker\\.ar"
  ]
